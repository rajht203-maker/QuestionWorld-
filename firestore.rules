rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'princerajmth5@gmail.com' ||
        request.auth.token.email == 'rajht203@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // Health / connection test doc
    match /test/connection {
      allow read: if true;
    }

    // Admin whitelist collection: signed in users can read authorized admins; only existing admins can manage admins
    match /admins/{adminEmail} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Converted quizzes created by admins: students/users can read/attempt quizzes; only admins can create/edit/delete
    match /convertedQuizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Processing jobs from AI PDF pipeline: admin full access, signed-in users can view
    match /processingJobs/{jobId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Uploaded documents library: admin access
    match /uploadedDocuments/{docId} {
      allow read, write: if isAdmin();
    }

    // Academic analysis reports: public read, admin write
    match /analysisReports/{reportId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student quiz attempts: student can create and read their own, admin can read/manage all
    match /quizAttempts/{attemptId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Custom subjects created by admins: public read for all students, admin only for write
    match /customSubjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public verified test papers: readable by anyone scanning the QR code, creatable on test generation
    match /verifiedTests/{testId} {
      allow read: if true;
      allow create, update: if true;
    }

    // Global platform settings & academic session: public read, admin write
    match /appSettings/{settingDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community lounge posts: public read for active posts; signed-in users can create/update (like, comment); admins or author can delete/disable
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isAdmin() || resource.data.authorId == request.auth.uid);
    }

    // Community restrictions: signed-in users can read their status; admin only write
    match /communityRestrictions/{userKey} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profile - strictly owner accessible
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);

      // Question History subcollection
      match /questionHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }

      // Favourite Questions subcollection
      match /favouriteQuestions/{favId} {
        allow read, write: if isOwner(userId);
      }

      // Saved Tests subcollection
      match /savedTests/{testId} {
        allow read, write: if isOwner(userId);
      }

      // Practice stats
      match /practiceStats/{statsId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
